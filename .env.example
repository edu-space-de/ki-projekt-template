# .env.example — Vorlage. Kopieren zu .env und echte Werte eintragen:
#     cp .env.example .env
#
# WICHTIG: .env ist in .gitignore und wird NIE committet. Diese .env.example
# enthaelt nur Platzhalter und DARF committet werden. Siehe SECURITY.md.

# --- LLM-/KI-APIs (Schluessel erhaltet ihr aus der Lehrveranstaltung) ---
OPENAI_API_KEY=<hier-euren-key-eintragen>
# ANTHROPIC_API_KEY=<...>

# --- Datenbank (Beispiel) ---
# DATABASE_URL=postgres://user:passwort@host:5432/dbname

# --- Weitere Dienste nach Bedarf ---
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=<...>
